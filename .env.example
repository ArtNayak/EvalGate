OLLAMA_APP_MODEL=qwen2.5:3b
OLLAMA_JUDGE_MODEL=qwen2.5:3b      # use a 7B model here if you have 8 GB+ RAM
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
PROMPT_VERSION=v1
TOP_K=3
REFUSAL_SIM_THRESHOLD=0.35         # placeholder; tune with the threshold sweep
TOOL_FAIL_MODE=none                # none | timeout | error | empty
PRICE_IN_PER_1K=0.0005             # notional, for the cost column only
PRICE_OUT_PER_1K=0.0015
# LANGSMITH_TRACING=true           # optional
# LANGSMITH_API_KEY=               # optional, needs a free account
